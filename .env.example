# Copy to .env.local for local testing and add the same values in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# OAuth client of the Google Cloud project (type: Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced by: node scripts/google-auth.mjs
GOOGLE_REFRESH_TOKEN=
# The Google account the token belongs to (used as the e-mail sender)
GOOGLE_ACCOUNT_EMAIL=

# Comma separated recipients of the "new record" notification e-mail
MAIL_TO=
